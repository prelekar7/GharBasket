        "title": "DeviceOut",
        "type": "object"
      },
      "ExchangeIn": {
        "description": "Exactly one of `firebase_id_token` (always) or `dev_phone` (only with APP_ENV=dev).",
        "properties": {
          "dev_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Priya"
            ],
            "title": "Dev Name"
          },
          "dev_phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "+919800000001"
            ],
            "title": "Dev Phone"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceIn"
          },
          "firebase_id_token": {
            "anyOf": [
              {
                "maxLength": 8192,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firebase Id Token"
          }
        },
        "required": [
          "device"
        ],
        "title": "ExchangeIn",
        "type": "object"
      },
      "ExchangeOut": {
        "properties": {
          "access_expires_in": {
            "examples": [
              900
            ],
            "title": "Access Expires In",
            "type": "integer"
          },
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Token"
          },
          "is_new_user": {
            "title": "Is New User",
            "type": "boolean"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "access_token",
          "access_expires_in",
          "refresh_token",
          "is_new_user",
          "user"
        ],
        "title": "ExchangeOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
