{
  "components": {
    "schemas": {
      "DeviceIn": {
        "properties": {
          "platform": {
            "enum": [
              "android",
              "web"
            ],
            "title": "Platform",
            "type": "string"
          },
          "push_token": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Push Token"
          }
        },
        "required": [
          "platform"
        ],
        "title": "DeviceIn",
        "type": "object"
      },
      "DeviceOut": {
        "description": "A signed-in device or browser (one session).",
        "properties": {
          "current": {
            "title": "Current",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_seen_at": {
            "format": "date-time",
            "title": "Last Seen At",
            "type": "string"
          },
          "platform": {
            "enum": [
              "android",
              "web"
            ],
            "title": "Platform",
            "type": "string"
          },
          "signed_in_at": {
            "format": "date-time",
            "title": "Signed In At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "platform",
          "signed_in_at",
          "last_seen_at",
          "current"
        ],
        "title": "DeviceOut",
        "type": "object"
      },
      "ExchangeIn": {
        "description": "Exactly one of `firebase_id_token` (always) or `dev_phone` (only with APP_ENV=dev).",
        "properties": {
          "dev_name": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "Priya"
            ],
            "title": "Dev Name"
          },
          "dev_phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "+919800000001"
            ],
            "title": "Dev Phone"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceIn"
          },
          "firebase_id_token": {
            "anyOf": [
              {
                "maxLength": 8192,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firebase Id Token"
          }
        },
        "required": [
          "device"
        ],
        "title": "ExchangeIn",
        "type": "object"
      },
      "ExchangeOut": {
        "properties": {
          "access_expires_in": {
            "examples": [
              900
            ],
            "title": "Access Expires In",
            "type": "integer"
          },
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Token"
          },
          "is_new_user": {
            "title": "Is New User",
            "type": "boolean"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "access_token",
          "access_expires_in",
          "refresh_token",
          "is_new_user",
          "user"
        ],
        "title": "ExchangeOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "title": "Health",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "enum": [
              "en-IN",
              "hi-IN",
              "mr-IN"
            ],
            "title": "Locale",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "phone_e164": {
            "title": "Phone E164",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleOut"
            },
            "title": "Roles",
            "type": "array"
          },
          "senior_mode": {
            "title": "Senior Mode",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "phone_e164",
          "name",
          "locale",
          "senior_mode",
          "roles"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "MeUpdate": {
        "additionalProperties": false,
        "description": "Only the fields sent are changed. `name: null` clears the name.",
        "properties": {
          "locale": {
            "anyOf": [
              {
                "enum": [
                  "en-IN",
                  "hi-IN",
                  "mr-IN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "senior_mode": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Senior Mode"
          }
        },
        "title": "MeUpdate",
        "type": "object"
      },
      "Ready": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed",
                "not_configured",
                "skipped"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Ready",
        "type": "object"
      },
      "RefreshIn": {
        "description": "Apps send the refresh token; browsers send `{}` and the `gb_rt` cookie carries it.",
        "properties": {
          "refresh_token": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          }
        },
        "title": "RefreshIn",
        "type": "object"
      },
      "RoleGrantIn": {
        "additionalProperties": false,
        "description": "Grant a role to an existing user (they must have signed in once).",
        "properties": {
          "phone_e164": {
            "examples": [
              "+919800000001"
            ],
            "title": "Phone E164",
            "type": "string"
          },
          "role": {
            "enum": [
              "captain",
              "kitchen_partner",
              "rider",
              "packer",
              "hub_manager",
              "franchise_owner",
              "ngo_coordinator",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "scope_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope Id"
          }
        },
        "required": [
          "phone_e164",
          "role"
        ],
        "title": "RoleGrantIn",
        "type": "object"
      },
      "RoleGrantOut": {
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          },
          "scope_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope Id"
          },
          "scope_type": {
            "anyOf": [
              {
                "enum": [
                  "society",
                  "hub",
                  "ngo"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope Type"
          },
          "status": {
            "enum": [
              "applied",
              "kyc_pending",
              "verified",
              "suspended"
            ],
            "title": "Status",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "role",
          "scope_type",
          "scope_id",
          "status",
          "user_id"
        ],
        "title": "RoleGrantOut",
        "type": "object"
      },
      "RoleOut": {
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          },
          "scope_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope Id"
          },
          "scope_type": {
            "anyOf": [
              {
                "enum": [
                  "society",
                  "hub",
                  "ngo"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope Type"
          },
          "status": {
            "enum": [
              "applied",
              "kyc_pending",
              "verified",
              "suspended"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "role",
          "scope_type",
          "scope_id",
          "status"
        ],
        "title": "RoleOut",
        "type": "object"
      },
      "TokensOut": {
        "description": "Apps get both tokens. Browsers (`X-GB-Client: web`) get null here: the tokens are set as\nhttpOnly cookies that JavaScript cannot read.",
        "properties": {
          "access_expires_in": {
            "examples": [
              900
            ],
            "title": "Access Expires In",
            "type": "integer"
          },
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Token"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          }
        },
        "required": [
          "access_token",
          "access_expires_in",
          "refresh_token"
        ],
        "title": "TokensOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "enum": [
              "en-IN",
              "hi-IN",
              "mr-IN"
            ],
            "title": "Locale",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "phone_e164": {
            "title": "Phone E164",
            "type": "string"
          },
          "senior_mode": {
            "title": "Senior Mode",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "phone_e164",
          "name",
          "locale",
          "senior_mode"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "AccessToken": {
        "description": "Access token from POST /v1/auth/exchange or /v1/auth/refresh (15 minutes).",
        "scheme": "bearer",
        "type": "http"
      },
      "OperatorToken": {
        "description": "JOBS_TOKEN from Infisical. Only for operators and scheduled jobs.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Kitchen Autopilot and Society Captain platform. Errors use application/problem+json.",
    "title": "GharBasket API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/user-roles": {
      "post": {
        "operationId": "grant_role_v1_admin_user_roles_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-active-role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Active-Role"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleGrantIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleGrantOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "identity.user_not_found"
          },
          "409": {
            "content": {
              "application/problem+json": {}
            },
            "description": "identity.role_exists"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "identity.invalid_scope, request.idempotency_mismatch, request.invalid"
          }
        },
        "security": [
          {
            "AccessToken": []
          }
        ],
        "summary": "Admin: give a user a staff role (Idempotency-Key required; audit-logged)",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/auth/exchange": {
      "post": {
        "operationId": "exchange_v1_auth_exchange_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.invalid_token: the Firebase ID token is not valid"
          },
          "403": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.dev_login_disabled, auth.account_disabled or auth.csrf_rejected"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.rate_limited (see Retry-After)"
          },
          "503": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.provider_unavailable: Firebase keys could not be fetched"
          }
        },
        "summary": "Sign in (or sign up) with a verified phone number",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.invalid_token"
          }
        },
        "security": [
          {
            "AccessToken": []
          }
        ],
        "summary": "Sign this device out (takes effect at once)",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/auth/logout-all": {
      "post": {
        "operationId": "logout_all_v1_auth_logout_all_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.invalid_token"
          }
        },
        "security": [
          {
            "AccessToken": []
          }
        ],
        "summary": "Sign out on every device (takes effect at once)",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refresh_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokensOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.invalid_token, or auth.refresh_reused (session ended)"
          },
          "403": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.csrf_rejected"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.rate_limited (see Retry-After)"
          }
        },
        "summary": "Exchange a refresh token for new tokens (the old refresh token stops working)",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check (does not touch the database)",
        "tags": [
          "platform"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.invalid_token"
          }
        },
        "security": [
          {
            "AccessToken": []
          }
        ],
        "summary": "The signed-in user and all their roles",
        "tags": [
          "identity"
        ]
      },
      "patch": {
        "operationId": "update_me_v1_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.invalid_token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AccessToken": []
          }
        ],
        "summary": "Change name, language or senior mode (only the fields sent)",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/me/devices": {
      "get": {
        "operationId": "my_devices_v1_me_devices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceOut"
                  },
                  "title": "Response My Devices V1 Me Devices Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {}
            },
            "description": "auth.invalid_token"
          }
        },
        "security": [
          {
            "AccessToken": []
          }
        ],
        "summary": "Devices and browsers where this account is signed in",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/me/devices/{device_id}": {
      "delete": {
        "operationId": "sign_out_device_v1_me_devices__device_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
