          "id",
          "slug",
          "name",
          "area",
          "status",
          "distance_m",
          "towers",
          "flats",
          "captain"
        ],
        "title": "SocietyOut",
        "type": "object"
      },
      "SocietyRequestIn": {
        "additionalProperties": false,
        "description": "Ask GharBasket to come to a society that isn't listed (US-8).",
        "properties": {
          "area": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "New Panvel"
            ],
            "title": "Area"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LatLng"
              },
              {
                "type": "null"
              }
            ],
            "description": "null when no pin was placed; never a default map centre"
          },
          "name": {
            "examples": [
              "Panvel Heights"
            ],
            "maxLength": 120,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
