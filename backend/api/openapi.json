  "info": {
    "description": "Kitchen Autopilot and Society Captain platform. Errors use application/problem+json.",
    "title": "GharBasket API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/user-roles": {
      "post": {
        "operationId": "grant_role_v1_admin_user_roles_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-active-role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Active-Role"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleGrantIn"
              }
