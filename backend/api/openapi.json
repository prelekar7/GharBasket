              240
            ],
            "title": "Flats"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "examples": [
              "Sunrise Towers"
            ],
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "examples": [
              "sunrise-towers-kharghar"
            ],
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "enum": [
              "prospect",
              "unlocking",
              "live",
              "paused"
            ],
            "title": "Status",
            "type": "string"
          },
          "towers": {
            "items": {
              "$ref": "#/components/schemas/Tower"
            },
            "title": "Towers",
            "type": "array"
          }
        },
