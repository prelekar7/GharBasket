{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/packages/api-client/src/generated",
      "!!**/dist",
      "!!**/.next",
      "!!**/storybook-static",
      "!!**/android",
      "!!docs",
      "!!.claude",
      "!!.codebuddy",
      "!!.cursor",
      "!!.gemini",
      "!!.kiro",
      "!!.qoder",
      "!!.vscode",
      "!!.mcp.json",
      "!!opencode.jsonc"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
