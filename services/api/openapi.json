{
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "title": "Health",
        "type": "object"
      },
      "Ready": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failed",
                "not_configured",
                "skipped"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Ready",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Kitchen Autopilot and Society Captain platform. Errors use application/problem+json.",
    "title": "GharBasket API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check (does not touch the database)",
        "tags": [
          "platform"
        ]
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "ready_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency is not reachable (problem+json)"
          }
        },
        "summary": "Readiness check (database and Valkey)",
        "tags": [
          "platform"
        ]
      }
    }
  }
}
