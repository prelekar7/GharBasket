# Local development settings: cp .env.example .env
# Staging and production values live in Infisical (`infisical run --env=staging -- ...`), never here.
# Never commit .env or real secrets.

# dev = local machine (docs on, dev login, operator endpoints open). Without APP_ENV the API
# assumes "prod" and refuses to start without its secrets.
APP_ENV=dev
LOG_LEVEL=INFO
# Readable logs locally; deployed environments log JSON lines.
LOG_JSON=false
# Only the Capacitor app needs CORS; browsers come through same-origin proxies.
CORS_ALLOW_ORIGINS=https://localhost
# Browser apps allowed to use cookie sign-in (the local Vite/Next dev servers are always allowed
# in dev). On staging: the two Vercel URLs, comma-separated.
# WEB_ORIGINS=

# PostgreSQL 18 in Docker (infra/compose)
POSTGRES_USER=gharbasket
POSTGRES_PASSWORD=gharbasket
POSTGRES_DB=gharbasket
POSTGRES_PORT=5432
# The API uses DATABASE_URL; migrations use DATABASE_URL_DIRECT (on Neon: the non-pooled URL).
DATABASE_URL=postgresql+asyncpg://gharbasket:gharbasket@localhost:5432/gharbasket
DATABASE_URL_DIRECT=postgresql+asyncpg://gharbasket:gharbasket@localhost:5432/gharbasket
# Tests only ever use a local database (they refuse anything else).
TEST_DATABASE_URL=postgresql+asyncpg://gharbasket:gharbasket@localhost:5432/gharbasket_test

# Valkey (Redis-compatible). Host port 6380 avoids clashing with a locally installed Redis on 6379.
VALKEY_PORT=6380
VALKEY_URL=redis://localhost:6380/0
TEST_VALKEY_URL=redis://localhost:6380/15

# S3-compatible storage: SeaweedFS locally, Cloudflare R2 on staging (region "auto").
S3_PORT=8333
S3_ENDPOINT_URL=http://localhost:8333
# The host the apps PUT uploads to (M0 §3.1); default S3_ENDPOINT_URL. The Android emulator
# reaches the laptop as http://10.0.2.2:8333.
# S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=gharbasket
S3_SECRET_KEY=gharbasket-local-secret
S3_REGION=auto
S3_BUCKET_MEDIA=gb-media
S3_BUCKET_PRIVATE=gb-private
S3_BUCKET_LAKE=gb-lake
S3_BUCKET_MLFLOW=gb-mlflow

# MLflow (optional "ml" profile). Host port 5001 because macOS AirPlay Receiver uses 5000.
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001

# Training jobs (backend/training, ADR-0025): your own data.gov.in key for the mandi price
# collector (register at data.gov.in → profile → API key). In GitHub Actions these are secrets.
# DATA_GOV_IN_API_KEY=
# API_URL=http://localhost:8000

# OSRM road network (optional "routing" profile; `just osrm-prepare` once, then `just up-routing`).
OSRM_PORT=5050

# Operator token for /v1/ready and /v1/internal/jobs/*. Optional locally (endpoints stay open);
# required on staging and prod.
# JOBS_TOKEN=

# Arrive with the login PRs; locally the API will use built-in development keys.
# JWT_SIGNING_KEY=
# REFRESH_TOKEN_PEPPER=
# FIREBASE_PROJECT_ID=

# KYC numbers of partners (M8): the pgcrypto key (with its version, for rotation) and the HMAC
# pepper for duplicate checks. Unset locally: dev-only values; required on staging and prod.
# KYC_ENCRYPTION_KEY=
# KYC_KEY_VERSION=1
# KYC_HASH_PEPPER=

# Razorpay wallet top-ups (M5), test mode only: live keys (rzp_live_) are refused at startup.
# Unset locally: top-ups are dev orders, paid with POST /v1/dev/razorpay/pay (APP_ENV dev/test).
# The webhook secret is the one you set on the dashboard's webhook for /v1/payments/webhook/razorpay.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Kindness points one donated meal takes (M5 §3.6).
# KINDNESS_GOAL=500
# Who pays partners' weekly payouts (M5 §3.5): only `simulated` is built (no real money moves);
# `razorpay_route` (pilot) is refused at start until it is built.
# PAYOUTS_PROVIDER=simulated

# Push notifications (M11): the Firebase service account key file's JSON on one line
# (Firebase console → Project settings → Service accounts → Generate new private key).
# Unset: pushes are skipped; the in-app inbox still gets every message.
# FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"...","token_uri":"https://oauth2.googleapis.com/token"}

# WhatsApp (M11, Cloud API; Meta app → WhatsApp → API setup). Off unless all four are set: until
# then WhatsApp deliveries are skipped. The webhook (/v1/webhooks/whatsapp) needs the last two.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# The ML service (backend/ml). Unset: the API's rule-based planner answers. Locally: `just dev-ml`;
# deployed: the Render ML service's URL (render.yaml, gharbasket-ml), e.g. https://gharbasket-ml.onrender.com
# ML_SERVICE_URL=http://localhost:8100
# ML_SERVICE_TOKEN=
# Ghar Saathi (M13): tokens (uncached in + out) a user may spend a day and how long the API waits
# for a turn. The ML service (its ANTHROPIC_API_KEY setting) never calls the API back.
# ASSISTANT_DAILY_TOKENS=60000
# ASSISTANT_TIMEOUT_S=30
# The pantry twin drafts milk and curd only when on; off until the eval target holds (M10 §3.3).
# PANTRY_TWIN_ENABLED=false
# Green slots: a box's slot quote and move with a saving (M10 §3.8); off answers 404. On for MS-D.
# GREEN_SLOTS_ENABLED=false
# Tiffin assignment fairness weight, paise per portion (M8 §3.4).
# PARTNERS_FAIRNESS_LAMBDA=300
# The data-source label of real rows in monitoring (eval protocol §2): pilot until launch, then live.
# REAL_DATA_SOURCE=pilot
# Where links in the API's answers point. PUBLIC_WEB_URL is the public site (referral links,
# PUBLIC_WEB_URL/s/<slug>?ref=<code>, M9 §3.3); APP_WEB_URL the customer PWA (a society page's join
# button, APP_WEB_URL/join?s=<slug>, M12 §3.7). On staging: the Vercel URLs of the console and PWA.
# PUBLIC_WEB_URL=https://gharbasket.in
# APP_WEB_URL=https://app.gharbasket.in
# Product analytics (never send names or phone numbers).
# POSTHOG_API_KEY=
# POSTHOG_HOST=
