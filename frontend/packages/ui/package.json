{
  "name": "@gharbasket/ui",
  "version": "0.1.0",
  "private": true,
  "description": "GharBasket design tokens, fonts, Tailwind v4 theme and components on React Aria",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.js",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "storybook build -o storybook-static --quiet",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "sync-tokens": "node scripts/sync-tokens.js",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/mukta": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react-aria-components": "1.21.1",
    "sonner": "2.0.8",
    "tailwind-variants": "3.3.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
