# Copy to .env.local (gitignored). Public values only; never secrets.
# Mock the API with MSW. Opt-in, and only on the dev server (`pnpm dev`): builds never include it.
# Leave unset to use the real API (locally: just up && just migrate && just seed && just dev).
VITE_API_MOCK=true
# Dev server: where relative /v1 is forwarded when mocks are off (a local backend).
VITE_API_PROXY_TARGET=http://localhost:8000
# Native build only (`pnpm build:native`): absolute API URL, e.g. the staging API on Render.
VITE_API_BASE_URL=
# Firebase web config: `pnpm env:pull` fills these from Infisical staging.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# "true" turns off web app verification, for Firebase fictional test numbers only. `pnpm env:pull`
# copies it from Infisical (FIREBASE_TEST_MODE); never set it for real phone numbers.
VITE_FIREBASE_TEST_MODE=
