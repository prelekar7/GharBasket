# Copy to .env.local (gitignored). Public values only; never secrets.
# Mock the API with MSW (on unless "false"), until the backend is live on staging.
VITE_API_MOCK=true
# Dev server: where relative /v1 is forwarded when mocks are off (a local backend).
VITE_API_PROXY_TARGET=http://localhost:8000
# Native build only (`pnpm build:native`): absolute API URL, e.g. the staging API on Render.
VITE_API_BASE_URL=
# Firebase web config: `pnpm env:pull` fills these from Infisical staging.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Staging uses Firebase fictional test numbers only, so web app verification is turned off.
VITE_FIREBASE_TEST_MODE=true
